# ─────────────────────────────────────────────────────────
# Autoscaling Orchestrator — Environment Variables
# Copy this file to .env and fill in your real values:
#   cp .env.example .env
# ⚠️  NEVER commit .env to git — it contains secrets!
# ─────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────
PORT=3000

# ── AWS Credentials ─────────────────────────────────────
# Create an IAM user with EC2 permissions and paste keys here
AWS_ACCESS_KEY_ID=your-access-key-id-here
AWS_SECRET_ACCESS_KEY=your-secret-access-key-here
AWS_REGION=us-east-1

# ── EC2 Instance Configuration ──────────────────────────
# AMI ID — the Amazon Machine Image to use for new instances
# (e.g. Ubuntu 22.04 LTS: ami-0c7217cdde317cfec in us-east-1)
AWS_AMI_ID=ami-0c7217cdde317cfec

# Instance type — t2.micro is free-tier eligible
AWS_INSTANCE_TYPE=t2.micro

# Key pair name — must already exist in your AWS account
AWS_KEY_PAIR_NAME=my-key-pair

# Security group ID — must allow ports 22 (SSH), 80, 3000, 8080
AWS_SECURITY_GROUP_ID=sg-xxxxxxxxxxxxxxxxx

# ── Coder / VS Code Server ──────────────────────────────
# Password for the VS Code server running inside the instance
CODER_PASSWORD=change-me-to-a-strong-password
